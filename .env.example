# Salin ke .env lalu sesuaikan.
#
# KOMPATIBILITAS NAMA (Aether -> Damar): seluruh kunci di bawah ini
# kanonik dengan awalan DAMAR_. Instalasi lama yang masih memakai
# AETHER_* TETAP JALAN — nilainya dialiaskan otomatis oleh
# src/config/envCompat.js. Bila keduanya diisi, DAMAR_* yang menang;
# kunci yang tidak ada tetap tidak ada (autentikasi tetap fail-closed).
# Ejaan AETHER_* DEPRECATED — lihat
# docs/architecture/DAMAR-IDENTITY-MIGRATION.md.

# ---- Daemon -----------------------------------------------------
PORT=3000
HOST=0.0.0.0
APP_NAME=Damar
APP_VERSION=0.1.0
NODE_ENV=development

# Token bidang kendali (/api/v1/console).
# WAJIB diisi bila daemon berjalan di PC rumah dan terjangkau LAN —
# tanpa ini, endpoint chat, eksekusi tool, dan filesystem terbuka
# tanpa autentikasi bagi siapa pun di jaringan yang sama.
# Isikan nilai yang sama di Damar Console -> Settings -> Token akses.
DAMAR_TOKEN=

# ---- AI ----------------------------------------------------------
# llamacpp | openrouter | groq | google | dst (lihat Settings -> AI)
AI_PROVIDER=llamacpp

# Context window inferensi lokal (node-llama-cpp).
DAMAR_LOCAL_NUM_CTX=8192

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ---- Memori jangka panjang ---------------------------------------
# Basis data memori terpisah dari data/damar.db.
# DAMAR_MEMORY_DB=data/memory.db

# Embedding opsional untuk pencarian makna (endpoint OpenAI-compatible).
# Tanpa ini memori tetap jalan, hanya pencariannya sebatas kata kunci.
# DAMAR_EMBED_URL=http://host-anda/v1
# DAMAR_EMBED_MODEL=nomic-embed-text

# ---- Suara masuk (STT) -------------------------------------------
# Suara KELUAR (Damar bicara) sudah jalan tanpa konfigurasi lewat
# suara OS di Console. Suara MASUK butuh backend transcribe
# kompatibel-OpenAI (mis. faster-whisper-server / whisper.cpp server).
# Tanpa ini, mic dinonaktifkan dengan pesan jelas — mengetik tetap bisa.
# DAMAR_STT_URL=http://localhost:8000/v1/audio/transcriptions
# DAMAR_STT_MODEL=Systran/faster-whisper-base
# DAMAR_STT_KEY=
#
# TTS neural (banyak suara + bahasa Indonesia). Endpoint /v1/audio/speech
# kompatibel-OpenAI, mis. Kokoro-FastAPI. Kosong → pakai suara OS.
# Efek "robot" diatur di layar Damar. Semua bisa diisi via Settings.
# DAMAR_TTS_URL=http://localhost:8880/v1/audio/speech
# DAMAR_TTS_MODEL=kokoro
# DAMAR_TTS_VOICE=af_heart

# ---- Voice Runtime (always-on assistant) -------------------------
# Voice = channel menuju Damar Core (jalur AI yang sama dengan
# Telegram/WhatsApp/Console). Nonaktif default; aktifkan untuk standby
# wake-word. Semua kegagalan (mic/STT/TTS/wake) TIDAK menjatuhkan daemon.
# DAMAR_VOICE_ENABLED=auto            # auto = aktif bila STT+rekam siap (wake word jalan)
# DAMAR_WAKE_WORD=Damar
# DAMAR_VOICE_WAKE_PROVIDER=local          # local keyword-match (tanpa model)
# DAMAR_VOICE_STT_PROVIDER=local           # lewat voiceService (faster-whisper)
# DAMAR_VOICE_TTS_PROVIDER=local           # lewat voiceService (edge-tts/Kokoro)
# DAMAR_VOICE_MAX_SESSION_MS=60000         # batas total satu giliran
# DAMAR_VOICE_VAD_TIMEOUT_MS=1200          # diam = selesai bicara
# DAMAR_VOICE_MAX_LISTEN_MS=10000          # jaring pengaman rekaman
# DAMAR_VOICE_AUDIO_BACKEND=cli            # "cli" untuk mic/speaker OS (arecord/sox/PowerShell); default "none"
# DAMAR_VOICE_ACK=Ya?                      # acknowledgement deterministik (tanpa LLM)
# DAMAR_VOICE_LANGUAGE=id
#
# Trigger alternatif: tepuk tangan 2x (double clap). Nonaktif default.
# DAMAR_VOICE_CLAP_ENABLED=true
# DAMAR_VOICE_CLAP_THRESHOLD=0.6           # level RMS (0..1) dianggap "bunyi keras"
# DAMAR_VOICE_CLAP_WINDOW_MS=800           # jendela maks antar dua tepukan
# DAMAR_VOICE_CLAP_MIN_CLAP_MS=30          # lebar minimum satu tepukan
# DAMAR_VOICE_CLAP_MIN_GAP_MS=100          # jeda minimum antar tepukan

# ---- Integrasi eksternal -----------------------------------------
# Menimpa nilai di configs/integrations.json.
# DAMAR_OPENCLAW_URL=http://localhost:18789
# DAMAR_HERMES_URL=http://localhost:8080
# DAMAR_OPENCLAW_KEY=
# DAMAR_HERMES_KEY=

# ---- Telegram ----------------------------------------------------
# Remote control Damar dari Telegram (long-polling, tanpa webhook).
# Token dari @BotFather. DAMAR_TELEGRAM_ALLOWED = daftar chat id
# yang boleh mengendalikan Damar (pisahkan koma). Kirim /id ke bot
# untuk mengetahui chat id-mu. Tanpa allowlist, bot hanya membalas /id.
# DAMAR_TELEGRAM_TOKEN=123456:ABC-DEF...
# DAMAR_TELEGRAM_ALLOWED=123456789

# ---- Membuat tool sendiri ----------------------------------------
# Set ke 1 agar tool buatan Damar langsung aktif tanpa persetujuan.
# Default (kosong) lebih aman: tool baru jadi draft sampai disetujui.
# DAMAR_TOOL_AUTOAPPROVE=

# ---- Lain-lain ----------------------------------------------------
MEMORY_PROVIDER=sqlite
AGENT_PROVIDER=damar
PLANNER_MODE=llm

# ---- Immich (galeri foto; dipakai skill pencari foto) -------------
# Kunci API dari Immich → Account Settings → API Keys.
IMMICH_API_KEY=GANTI_DENGAN_IMMICH_API_KEY

# ---- Spotify (pemutar musik; tool play_spotify) -------------------
# Dari https://developer.spotify.com/dashboard → Create app.
# Cukup untuk PENCARIAN & pemutaran embed di Console — tanpa login
# pengguna. Kosong = pencarian keyless fallback (lebih sering gagal).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- MQTT rumah (dashboard Ruang) ---------------------------------
# Broker MQTT (mis. Mosquitto di docker yang sama dengan HA).
# Alternatif lebih mudah: isi di Console → Settings → Rumah & Perangkat
# (tersimpan di configs/mqtt.json). Discovery HA otomatis diikuti.
DAMAR_MQTT_URL=
DAMAR_MQTT_USERNAME=
DAMAR_MQTT_PASSWORD=

# ---- Otak lokal langsung (node-llama-cpp, in-process) ------------
# Aktifkan model in-process sebagai otak Damar:
AI_PROVIDER=llamacpp
# Nama berkas GGUF di models/ (unduh: npm run model:pull)
DAMAR_MODEL_PATH=Qwen2.5-7B-Instruct-Q4_K_M.gguf
# Ukuran context (KV-cache); kecilkan bila RAM sempit
DAMAR_LOCAL_NUM_CTX=8192

# ---- GeminiWebApi (jembatan Gemini web->API, dukung gambar) -------
# Cookie dari gemini.google.com (F12 -> Application -> Cookies).
# Jalankan kontainer: npm run vision:gemini ; lalu pilih provider
# "GeminiWebApi" di Console -> Settings.
GEMINI_1PSID=
GEMINI_1PSIDTS=

# ---- MCP Client (Damar memakai server MCP eksternal) ------------
# Server MCP eksternal dijadikan tool Damar. Konfigurasi utama di
# configs/mcp.json (format: { servers: [{ id, command, args, env,
# allowedTools }] }). Contoh pemanggilan:
#   npx -y @modelcontextprotocol/server-filesystem /tmp
#
# Alternatif: JSON inline lewat env (menimpa berkas bila diisi).
#   DAMAR_MCP_SERVERS='[{"id":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]'
#
# allowedTools = null (semua tool server) atau array nama tool asli.
