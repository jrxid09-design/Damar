node_modules
node_modules/
.env*
*.log

# --- Konfigurasi runtime: LOKAL SAJA -------------------------------
# Berisi rahasia nyata (API key Binance, token Telegram/Home Assistant,
# kunci provider LLM) dan sesi WhatsApp. Sempat ikut terlacak dan
# ter-commit; sejak sini configs/ hanya hidup di mesin masing-masing.
# integrations.json dikecualikan: isinya template tanpa rahasia dan
# sudah menjadi bagian dari repo di develop.
configs/*
!configs/integrations.json
!configs/*.example

# --- DATA PRIBADI PER-INSTALASI: LOKAL SAJA ------------------------
# Repo ini open-source. Semua di bawah adalah "Damar versi kamu":
# memori, keadaan batin, watak yang terbentuk, jejak, pembukuan. Saat
# orang lain meng-install, semua dibuat ulang dari nol (kode auto-membuat
# foldernya) sehingga mereka mendapat Damar versi mereka sendiri.
data/
downloads/
logs/
paceDamar
DAMAR_STATE.json
DAMAR_SELF.md
# Ejaan LAMA (pra-rename Aether -> Damar): artefak runtime milik
# instalasi lama tetap diabaikan, bukan dihapus.
paceAether
AETHER_STATE.json
AETHER_SELF.md
ROADMAP.md

# Skrip lokal/eksperimen yang tak ikut rilis publik.
*-arsenal*.sh
check-*.sh
scripts/attack-*.sh

# Model bobot lokal (GGUF) — jangan commit, unduh sendiri
models/
*.gguf

# util lokal ekstrak cookie (jangan publish)
.get-cookies.js

nul

# DAMARSELF — hanya dokumen kanonik yang di-commit; runtime output dikecualikan
DamarSelf/evolution/experiments/*
!DamarSelf/evolution/experiments/.gitkeep
# Arsip AetherSelf pra-rename (isinya sudah diadopsi ke DamarSelf).
AetherSelf/
*.acc-scratch/

# --- MATA DEWA — DATA PRIBADI SPASIAL: LOKAL SAJA, JANGAN PERNAH COMMIT ---
# Peta menara PLN UPT Bogor milik pengguna (My Maps) dan seluruh hasil
# ekstraksinya — koordinat, nama menara, metadata situs, layer, deskripsi —
# adalah DATA PRIBADI PENGGUNA. Tidak boleh masuk git / source / tests /
# fixtures / docs / contoh / screenshot / log / artefak rilis. Hanya impor
# generik lokal yang didukung; repo memakai fixture SINTETIS.
private-data/
local-data/private/
*.private.kml
*.private.kmz
*.private.csv
*.private.geojson
*.private.json
# Cache disk provider Mata Dewa (boleh berisi hasil query lokasi nyata).
.mata-dewa-cache/
# Vault lokal (jangan pernah commit rahasia provider).
.mata-dewa-vault/
# State runtime Mata Dewa (watch policy, aset hasil impor privat).
data/mataDewa/
