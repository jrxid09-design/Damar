# FOUNDATION PACKAGING POLICY (repo-local, reproducible)
#
# npm >= 12 implements allow-git as a MODE switch (none | root | all),
# not a URL allowlist. libsignal is a TRANSITIVE git dependency
# (Damar -> @whiskeysockets/baileys@6.7.24 -> libsignal), so the
# narrowest mode that can install our declared graph is "all".
#
# COMPENSATING CONTROL: the candidate validator enforces a deterministic
# LOCKFILE POLICY GATE before install - the committed dependency graph
# may contain ONLY this pinned Git dependency:
#   github.com/whiskeysockets/libsignal-node
#   commit bcea72df9ec34d9d9140ab30619cf479c7c144c7 (HTTPS, repo-local pin)
#
# allow-git=all here is therefore a TRANSPORT permission only; the
# lockfile gate is the actual dependency allowlist.
allow-git=all
